# Twake Project web app
TWAKE_PROJECT_URL=https://projects.example.com
# As you (OIDC access token with the audience twake-projects, actions approved one by one):
TWAKE_PROJECT_TOKEN_COMMAND="/usr/local/bin/my-token-broker twake-projects --json"
TWAKE_PROJECT_OIDC_ISSUER=https://sso.example.com/
# or a 0600 file holding an access token:
# TWAKE_PROJECT_TOKEN_FILE=/home/alice/.config/mcp-twake-project/token
# Optional
# TWAKE_PROJECT_API_URL=https://projects.example.com/api
USER_TIMEZONE=Europe/Paris
# TWAKE_PROJECT_APPROVAL=elicit
USER_LANGUAGE=fr
