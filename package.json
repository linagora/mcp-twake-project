{
  "name": "mcp-twake-project",
  "version": "0.2.1",
  "description": "MCP server for Twake.ai Project: give any MCP-compatible AI assistant secure access to your projects, boards and tasks, with every write approved by you first",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-twake-project": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "twake",
    "twake.ai",
    "project",
    "tasks",
    "kanban",
    "linagora"
  ],
  "author": "LINAGORA <https://linagora.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/mcp-twake-project.git"
  },
  "homepage": "https://github.com/linagora/mcp-twake-project#readme",
  "bugs": {
    "url": "https://github.com/linagora/mcp-twake-project/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
